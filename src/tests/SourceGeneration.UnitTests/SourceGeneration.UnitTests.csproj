<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework />
		<TargetFrameworks>$(AllTargetFrameworks)</TargetFrameworks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
		<PackageReference Include="Purview.SourceGeneratorFramework" />
		<PackageReference Include="Purview.SourceGeneratorFramework.Testing.TUnit" />
	</ItemGroup>

	<ItemGroup>
		<!-- Reference the analyzer output as a normal reference so the test code can use HostKitGenerator. -->
		<ProjectReference
			Include="..\..\src\SourceGeneration\SourceGeneration.csproj"
			PrivateAssets="all"
			ReferenceOutputAssembly="true"
		/>
	</ItemGroup>

	<ItemGroup>
		<!-- Copy the analyzer release tracking files so AnalyzerReleaseTrackingTests can read them. -->
		<None
			Include="..\..\src\SourceGeneration\AnalyzerReleases.Shipped.md"
			Link="AnalyzerReleases\AnalyzerReleases.Shipped.md"
			CopyToOutputDirectory="PreserveNewest"
		/>
		<None
			Include="..\..\src\SourceGeneration\AnalyzerReleases.Unshipped.md"
			Link="AnalyzerReleases\AnalyzerReleases.Unshipped.md"
			CopyToOutputDirectory="PreserveNewest"
		/>
	</ItemGroup>
</Project>
