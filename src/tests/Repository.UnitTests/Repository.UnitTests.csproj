<Project Sdk="Microsoft.NET.Sdk">
	<ItemGroup>
		<!-- The Agent Skills conformance rule set, shipped by Purview.BuildSdk. The rules live in the
		     package so they are defined once rather than reimplemented here. -->
		<PackageReference Include="Purview.Skills.Testing" />
		<!-- The architecture rule set, so the dependency direction declared in
		     .config/architecture-policy.json fails the build instead of living in review. -->
		<PackageReference Include="Purview.Architecture.Testing" />
	</ItemGroup>
</Project>
