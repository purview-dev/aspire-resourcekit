<Project Sdk="Microsoft.NET.Sdk">
	<ItemGroup>
		<!-- Project V2 moved Aspire.Hosting to 17 in this test compilation; the library itself keeps the 13.6 floor. -->
		<PackageReference Include="Aspire.Hosting" VersionOverride="$(Aspire17Version)" />
		<PackageReference Include="Aspire.Hosting.Dotnet" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Options" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
		<PackageReference Include="Purview.SourceGeneratorFramework" />
		<PackageReference Include="Purview.SourceGeneratorFramework.Testing.TUnit" />
	</ItemGroup>

	<ItemGroup>
		<!-- Golden generated output, compared byte for byte by the generator tests. -->
		<None Update="Golden\**\*.txt" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\ResourceKit\ResourceKit.csproj" />
		<!-- Reference the analyzer output as a normal reference so the test code can use HostKitGenerator. -->
		<ProjectReference
			Include="..\..\src\SourceGeneration\SourceGeneration.csproj"
			PrivateAssets="all"
			ReferenceOutputAssembly="true"
		/>
		<ProjectReference
			Include="..\..\src\SourceGeneration.CodeFixes\SourceGeneration.CodeFixes.csproj"
			PrivateAssets="all"
			ReferenceOutputAssembly="true"
		/>
	</ItemGroup>
</Project>
