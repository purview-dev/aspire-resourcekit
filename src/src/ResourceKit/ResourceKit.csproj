<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework />
		<TargetFrameworks>$(AllTargetFrameworks)</TargetFrameworks>
		<IsPackable>true</IsPackable>
		<Title>Purview Aspire ResourceKit</Title>
		<Description>Composable and test-friendly Aspire resource isolation model for local, running, and publishing modes.</Description>
		<PackageTags>aspire;resource-kit;apphost;testing</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<AssemblyName>Purview.Aspire.ResourceKit</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Aspire.Hosting" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference
			Include="..\SourceGeneration\SourceGeneration.csproj"
			PrivateAssets="all"
			ReferenceOutputAssembly="false"
			OutputItemType="Analyzer"
		/>
	</ItemGroup>
</Project>
