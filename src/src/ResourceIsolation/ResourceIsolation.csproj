<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<PackageId>Purview.Aspire.ResourceIsolation</PackageId>
		<Title>Purview Aspire Resource Isolation</Title>
		<Description>Composable and test-friendly Aspire resource isolation model for local, running, and publishing modes.</Description>
		<PackageTags>aspire;resource-isolation;apphost;testing</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Aspire.Hosting" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
	</ItemGroup>

	<PropertyGroup>
		<ResourceIsolationSourceGeneratorProject>$(MSBuildThisFileDirectory)..\Analyzers\SourceGeneration.csproj</ResourceIsolationSourceGeneratorProject>
		<ResourceIsolationSourceGeneratorTargetFramework>netstandard2.0</ResourceIsolationSourceGeneratorTargetFramework>
		<ResourceIsolationSourceGeneratorAssembly>$(MSBuildThisFileDirectory)..\SourceGeneration\bin\$(Configuration)\$(ResourceIsolationSourceGeneratorTargetFramework)\Purview.Aspire.ResourceIsolation.SourceGeneration.dll</ResourceIsolationSourceGeneratorAssembly>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeResourceIsolationSourceGenerator</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference
			Include="$(ResourceIsolationSourceGeneratorProject)"
			PrivateAssets="all"
			ReferenceOutputAssembly="false"
			OutputItemType="Analyzer"
		/>
	</ItemGroup>

	<Target Name="IncludeResourceIsolationSourceGenerator" DependsOnTargets="Build">
		<Error
			Condition="!Exists('$(ProjectSdkSourceGeneratorAssembly)')"
			Text="The Purview Aspire Resource Isolation Source Generator was not found at '$(ResourceIsolationSourceGeneratorAssembly)'."
		/>

		<ItemGroup>
			<TfmSpecificPackageFile Include="$(ResourceIsolationSourceGeneratorAssembly)">
				<PackagePath>analyzers/dotnet/cs/</PackagePath>
			</TfmSpecificPackageFile>
		</ItemGroup>
	</Target>
</Project>
