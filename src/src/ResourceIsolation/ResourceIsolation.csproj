<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<PackageId>Purview.Aspire.ResourceIsolation</PackageId>
		<Title>Purview Aspire Resource Isolation</Title>
		<Description>Composable and test-friendly Aspire resource isolation model for local, running, and publishing modes.</Description>
		<PackageTags>aspire;resource-isolation;apphost;testing</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Aspire.Hosting" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference
			Include="..\SourceGeneration\SourceGeneration.csproj"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false"
			PrivateAssets="all"
		/>
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="/" />
	</ItemGroup>

	<!-- Ship the generator DLL and build props file inside the NuGet package. -->
	<Target Name="IncludeAnalyzerInPackage" BeforeTargets="_GetPackageFiles">
		<MSBuild
			Projects="..\SourceGeneration\SourceGeneration.csproj"
			Targets="GetTargetPath"
			Properties="Configuration=$(Configuration)"
			RebaseOutputs="true"
		>
			<Output TaskParameter="TargetOutputs" ItemName="_AnalyzerDll" />
		</MSBuild>
		<ItemGroup>
			<None
				Include="@(_AnalyzerDll)"
				Pack="true"
				PackagePath="analyzers/dotnet/cs"
				Visible="false"
			/>
			<None
				Include="$(MSBuildThisFileDirectory)build\Purview.Aspire.ResourceIsolation.props"
				Pack="true"
				PackagePath="build"
				Visible="false"
			/>
		</ItemGroup>
	</Target>
</Project>
