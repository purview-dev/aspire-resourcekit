<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!--
			The legacy AppHost SDK adds an implicit Aspire.Hosting.AppHost package reference, which cannot
			coexist with a central PackageVersion item (NU1009). These two Aspire 17 examples therefore
			pin their own packages; every other project remains centrally managed.
		-->
		<ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
		<OutputType>Exe</OutputType>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<!--
			Aspire 17 Project V2: Microsoft.NET.Sdk plus Aspire.Hosting.AppHost and
			Aspire.Hosting.Dotnet. A C# AppHost requires the Aspire CLI bundle (ASPIRE013), so the
			pinned CLI from .config/aspire-version must be installed before this project builds. Both
			pipelines install it; `just test` expects it on a developer machine.
		-->
		<!--
			ASPIREAZURE003 marks AzureVirtualNetworkResource/AzureSubnetResource as evaluation APIs. The
			hierarchy example (issue #57) intentionally demonstrates the production user's VNET/subnet
			composition with the installed SDK surface; suppressing the evaluation notice is deliberate.
		-->
		<NoWarn>$(NoWarn);ASPIREAZURE003;CA1034;CA1062;</NoWarn>
		<!--
			An Aspire AppHost nests the public options types the resource kit binds (CA1034), and its
			composition code is reached only from this executable's own entry point, so CA1062's
			public-API argument checks add nothing. Declared as deliberate for PRSGD0008.
		-->
		<PurviewPolicyExemptNoWarn>$(PurviewPolicyExemptNoWarn);CA1034;CA1062;</PurviewPolicyExemptNoWarn>
	</PropertyGroup>
	<ItemGroup>
		<!--
			Consumers get this from the package's buildTransitive assets; a ProjectReference does not import
			them, so the examples import the same file explicitly and exercise it on every build.
		-->
		<ResourceKitProject Include="..\Example.Service\Example.Service.csproj" Name="api" ClassName="Api" />
	</ItemGroup>
	<ItemGroup>
		<!-- The service is added by path with AddDotnetProject, so no ProjectReference is needed. -->
		<ProjectReference
			Include="..\Example.ServiceDefaults\Example.ServiceDefaults.csproj"
			IsAspireProjectResource="false"
		/>
		<ProjectReference Include="..\ResourceKit\ResourceKit.csproj" IsAspireProjectResource="false" />
		<ProjectReference
			Include="..\SourceGeneration\SourceGeneration.csproj"
			IsAspireProjectResource="false"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false"
			PrivateAssets="all"
		/>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Aspire.Hosting.AppHost" Version="$(Aspire17Version)" />
		<PackageReference Include="Aspire.Hosting.Dotnet" Version="$(Aspire17Version)" />
		<PackageReference Include="Aspire.Hosting.Azure.KeyVault" Version="$(Aspire17Version)" />
		<PackageReference Include="Aspire.Hosting.Azure.Network" Version="$(Aspire17Version)" />
		<PackageReference Include="Aspire.Hosting.Azure.PostgreSQL" Version="$(Aspire17Version)" />
		<PackageReference Include="Aspire.Hosting.Azure.Redis" Version="$(Aspire17Version)" />
		<PackageReference Include="Aspire.Hosting.Azure.Storage" Version="$(Aspire17Version)" />
	</ItemGroup>
	<Import Project="..\ResourceKit\Sdk\buildTransitive\Purview.Aspire.ResourceKit.targets" />
</Project>
