<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>Purview.Aspire.ResourceKit.Pipeline</AssemblyName>
		<RootNamespace>Purview.Aspire.ResourceKit.Pipeline</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ModularPipelines" />
		<PackageReference Include="ModularPipelines.DotNet" />
		<PackageReference Include="ModularPipelines.Git" />
		<PackageReference Include="ModularPipelines.GitHub" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
</Project>
