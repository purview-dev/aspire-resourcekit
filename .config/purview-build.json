{
	"Build": {
		"Solution": "src/ResourceKit.slnx",
		"TestRoot": "src/tests",
		"TestPatterns": "*Tests.csproj",
		"TestFilter": "/*/*/*/*[Category=Unit]"
	},
	"PackValidation": {
		// Explicit because Purview.Build 0.5.3 defaults RequiredCompilerFlags to empty. Earlier
		// versions forced this check on and could not be configured off, so these packages have
		// always been validated against it; declaring it keeps that behaviour.
		"RequiredCompilerFlags": ["optimization=release"],
		"RequireSymbolPackage": true,
		"RequireSymbolFiles": true,
		"RequiredContent": {
			"purview.aspire.resourcekit": [
				".agents/**.*",
				"analyzers/dotnet/cs/Purview.Aspire.ResourceKit.SourceGeneration.dll",
				"buildTransitive/Purview.Aspire.ResourceKit.props",
				"lib/$(TFM)/Purview.Aspire.ResourceKit.dll",
				"lib/$(TFM)/Purview.Aspire.ResourceKit.xml",
				"README.md",
				"purview-logo-light.png"
			]
		}
	},
	"Release": {
		"Mode": "None"
	}
}
