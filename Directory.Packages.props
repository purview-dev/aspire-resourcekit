<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<TUnitVersion>1.63.0</TUnitVersion>
		<ModularPipelinesVersion>3.2.8</ModularPipelinesVersion>
		<PurviewSourceGeneratorFrameworkVersion>[1.0.0-prerelease.18,)</PurviewSourceGeneratorFrameworkVersion>
	</PropertyGroup>
	<ItemGroup>
		<PackageVersion Include="Aspire.Azure.Npgsql" Version="13.4.6" />
		<PackageVersion Include="Aspire.Azure.Security.KeyVault" Version="13.4.6" />
		<PackageVersion Include="Aspire.Azure.Storage.Blobs" Version="13.4.6" />
		<PackageVersion Include="Aspire.Hosting" Version="13.4.6" />
		<PackageVersion Include="Aspire.Hosting.Azure.AppContainers" Version="13.3.5" />
		<PackageVersion Include="Aspire.Hosting.Azure.ApplicationInsights" Version="13.3.5" />
		<PackageVersion Include="Aspire.Hosting.Azure.KeyVault" Version="13.4.6" />
		<PackageVersion Include="Aspire.Hosting.Azure.PostgreSQL" Version="13.4.6" />
		<PackageVersion Include="Aspire.Hosting.Azure.Redis" Version="13.4.6" />
		<PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="13.4.6" />
		<PackageVersion Include="Aspire.Microsoft.Azure.StackExchangeRedis" Version="13.4.6" />
		<PackageVersion Include="Bogus" Version="35.6.5" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
		<PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.10" />
		<PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
		<PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.301" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
		<!-- Keep Roslyn pinned only for netstandard2.0 because the generator must not pull System.Collections.Immutable 10.x into net8+ consumer and test builds. -->
		<PackageVersion
			Include="Microsoft.CodeAnalysis.Analyzers"
			Version="3.11.0"
			Condition="'$(TargetFramework)' == 'netstandard2.0'"
		/>
		<PackageVersion
			Include="Microsoft.CodeAnalysis.CSharp"
			Version="4.13.0"
			Condition="'$(TargetFramework)' == 'netstandard2.0'"
		/>
		<PackageVersion
			Include="Microsoft.CodeAnalysis.Analyzers"
			Version="5.6.0"
			Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0' Or '$(TargetFramework)' == 'net10.0'"
		/>
		<PackageVersion
			Include="Microsoft.CodeAnalysis.CSharp"
			Version="5.6.0"
			Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0' Or '$(TargetFramework)' == 'net10.0'"
		/>
		<PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="10.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Telemetry.Abstractions" Version="10.8.0" />
		<PackageVersion Include="Purview.Telemetry.SourceGenerator" Version="4.4.0" />
		<PackageVersion
			Include="Purview.SourceGeneratorFramework"
			Version="$(PurviewSourceGeneratorFrameworkVersion)"
		/>
		<PackageVersion
			Include="Purview.SourceGeneratorFramework.Testing.TUnit"
			Version="$(PurviewSourceGeneratorFrameworkVersion)"
		/>
		<PackageVersion Include="Microsoft.Testing.Platform.MSBuild" Version="2.3.2" />
		<PackageVersion Include="ModularPipelines" Version="$(ModularPipelinesVersion)" />
		<PackageVersion Include="ModularPipelines.DotNet" Version="$(ModularPipelinesVersion)" />
		<PackageVersion Include="ModularPipelines.Git" Version="$(ModularPipelinesVersion)" />
		<PackageVersion Include="ModularPipelines.GitHub" Version="$(ModularPipelinesVersion)" />
		<PackageVersion Include="TUnit" Version="$(TUnitVersion)" />
		<PackageVersion Include="TUnit.Aspire" Version="$(TUnitVersion)" />
		<PackageVersion Include="TUnit.Mocks" Version="$(TUnitVersion)" />
		<PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
		<PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.8.0" />
		<PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
		<PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
	</ItemGroup>
</Project>
